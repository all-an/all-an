package main

// The messages store. Postgres holds nothing else: quizzes and the timesheet live in the browser.

import "core:c"
import "core:fmt"
import "core:log"
import "core:strings"
import "core:sync"

Db :: struct {
	conninfo: cstring,
	conn:     PGconn,
	// libpq connections are not thread safe and the server runs several threads, so one at a time.
	mu:       sync.Mutex,
}

db: Db

Message :: struct {
	id:         string,
	ip:         string,
	name:       string,
	email:      string,
	body:       string,
	created_at: string,
}

Send_Result :: enum {
	Sent,
	// This address has already written today.
	Limited,
	Failed,
}

// Applied in order, once each, and recorded in schema_migrations. Append; never edit one that has shipped.
MIGRATIONS := [?]cstring {
	`CREATE TABLE messages (
		id         BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
		ip         VARCHAR(45)  NOT NULL,
		-- The UTC calendar day the message was sent. "One a day" is the calendar, not 24 hours, so
		-- somebody who wrote at 23:50 can write again at 00:10 - which is what "tomorrow" means.
		sent_on    DATE         NOT NULL DEFAULT ((now() AT TIME ZONE 'utc')::date),
		name       VARCHAR(80),
		email      VARCHAR(254),
		body       TEXT         NOT NULL,
		created_at TIMESTAMPTZ  NOT NULL DEFAULT now(),

		CONSTRAINT chk_messages_body CHECK (length(btrim(body)) > 0 AND length(body) <= 5000),
		-- The database is what enforces the limit, so two simultaneous requests cannot both get in.
		CONSTRAINT uq_messages_ip_day UNIQUE (ip, sent_on)
	)`,
	`CREATE INDEX idx_messages_created ON messages (created_at DESC)`,
	`CREATE TABLE users (
		id            BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
		-- Stored lower-cased, so "Ann@x.com" and "ann@x.com" are one account.
		email         VARCHAR(254) NOT NULL,
		-- argon2id$memory_kib$passes$parallelism$salt_hex$key_hex. Never the password.
		password_hash TEXT         NOT NULL,
		created_ip    VARCHAR(45)  NOT NULL,
		created_at    TIMESTAMPTZ  NOT NULL DEFAULT now(),

		CONSTRAINT uq_users_email UNIQUE (email),
		CONSTRAINT chk_users_email_lower CHECK (email = lower(email))
	)`,
	`CREATE TABLE sessions (
		-- SHA-256 of the cookie's token, so a copy of this table cannot be used to sign in.
		token_hash CHAR(64)    PRIMARY KEY,
		user_id    BIGINT      NOT NULL REFERENCES users (id) ON DELETE CASCADE,
		created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
		expires_at TIMESTAMPTZ NOT NULL
	)`,
	`CREATE INDEX idx_sessions_user ON sessions (user_id)`,
	`CREATE INDEX idx_sessions_expires ON sessions (expires_at)`,
	`CREATE TABLE auth_attempts (
		id    BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
		-- 'login' rows are failures only; 'register' rows are attempts.
		kind  VARCHAR(8)   NOT NULL,
		ip    VARCHAR(45)  NOT NULL,
		email VARCHAR(254),
		at    TIMESTAMPTZ  NOT NULL DEFAULT now()
	)`,
	`CREATE INDEX idx_auth_attempts_ip ON auth_attempts (kind, ip, at)`,
	`CREATE INDEX idx_auth_attempts_email ON auth_attempts (kind, email, at)`,
}

MIGRATION_LOCK :: 7351201

@(private = "file")
lock :: proc() -> bool {
	sync.mutex_lock(&db.mu)
	if db.conn == nil || PQstatus(db.conn) != .OK {
		if db.conn == nil {
			db.conn = PQconnectdb(db.conninfo)
		} else {
			PQreset(db.conn)
		}
	}
	if PQstatus(db.conn) != .OK {
		log.errorf("database: %s", PQerrorMessage(db.conn))
		sync.mutex_unlock(&db.mu)
		return false
	}
	return true
}

@(private = "file")
unlock :: proc() {
	sync.mutex_unlock(&db.mu)
}

// Runs one statement with values passed separately from the SQL. A nil entry is SQL NULL.
@(private = "file")
exec :: proc(sql: cstring, params: ..cstring) -> PGresult {
	return PQexecParams(db.conn, sql, c.int(len(params)), nil, raw_data(params), nil, nil, 0)
}

@(private = "file")
ok_status :: proc(res: PGresult) -> bool {
	status := PQresultStatus(res)
	return status == .COMMAND_OK || status == .TUPLES_OK
}

// Runs a statement whose result nobody needs. Returns false (and logs) when it failed.
@(private = "file")
run :: proc(sql: cstring, params: ..cstring) -> bool {
	res := exec(sql, ..params)
	defer PQclear(res)
	if !ok_status(res) {
		log.errorf("database: %s", PQresultErrorMessage(res))
		return false
	}
	return true
}

// A parameter value: empty means SQL NULL.
@(private = "file")
cstr :: proc(s: string) -> cstring {
	return strings.clone_to_cstring(s, context.temp_allocator) if len(s) > 0 else nil
}

@(private = "file")
cell :: proc(res: PGresult, row, col: c.int, allocator := context.temp_allocator) -> string {
	if PQgetisnull(res, row, col) == 1 {
		return ""
	}
	return strings.clone(string(PQgetvalue(res, row, col)), allocator)
}

db_init :: proc(url: string) -> bool {
	db.conninfo = strings.clone_to_cstring(url)
	if !lock() {
		return false
	}
	defer unlock()
	return migrate()
}

@(private = "file")
migrate :: proc() -> bool {
	// One instance migrates at a time: a second one waits here, then finds nothing left to do.
	run("SELECT pg_advisory_lock($1::bigint)", fmt.ctprintf("%d", MIGRATION_LOCK)) or_return
	defer run("SELECT pg_advisory_unlock($1::bigint)", fmt.ctprintf("%d", MIGRATION_LOCK))

	run("CREATE TABLE IF NOT EXISTS schema_migrations (version INTEGER PRIMARY KEY, applied_at TIMESTAMPTZ NOT NULL DEFAULT now())") or_return

	for sql, i in MIGRATIONS {
		version := fmt.ctprintf("%d", i + 1)

		check := exec("SELECT 1 FROM schema_migrations WHERE version = $1::int", version)
		applied := ok_status(check) && PQntuples(check) > 0
		PQclear(check)
		if applied {
			continue
		}

		run("BEGIN") or_return
		if !run(sql) || !run("INSERT INTO schema_migrations (version) VALUES ($1::int)", version) {
			run("ROLLBACK")
			return false
		}
		run("COMMIT") or_return
		log.infof("database: applied migration %d", i + 1)
	}
	return true
}

db_ping :: proc() -> bool {
	if !lock() {
		return false
	}
	defer unlock()
	return run("SELECT 1")
}

// Stores a message unless this address has already sent one today. `name` and `email` may be empty.
messages_insert :: proc(ip, name, email, body: string) -> Send_Result {
	if !lock() {
		return .Failed
	}
	defer unlock()

	res := exec(
		`INSERT INTO messages (ip, name, email, body)
		 VALUES ($1, $2, $3, $4)
		 ON CONFLICT (ip, sent_on) DO NOTHING
		 RETURNING id`,
		cstr(ip),
		cstr(name),
		cstr(email),
		cstr(body),
	)
	defer PQclear(res)

	if !ok_status(res) {
		log.errorf("database: %s", PQresultErrorMessage(res))
		return .Failed
	}
	// No row back means the (ip, day) slot was already taken.
	return .Sent if PQntuples(res) > 0 else .Limited
}

messages_recent :: proc(limit: int) -> []Message {
	if !lock() {
		return nil
	}
	defer unlock()

	res := exec(
		`SELECT id::text, ip, coalesce(name, ''), coalesce(email, ''), body,
		        to_char(created_at AT TIME ZONE 'utc', 'YYYY-MM-DD HH24:MI "UTC"')
		 FROM messages ORDER BY created_at DESC, id DESC LIMIT $1::int`,
		fmt.ctprintf("%d", limit),
	)
	defer PQclear(res)

	if !ok_status(res) {
		log.errorf("database: %s", PQresultErrorMessage(res))
		return nil
	}

	rows := int(PQntuples(res))
	out := make([]Message, rows, context.temp_allocator)
	for i in 0 ..< rows {
		r := c.int(i)
		out[i] = Message {
			id         = cell(res, r, 0),
			ip         = cell(res, r, 1),
			name       = cell(res, r, 2),
			email      = cell(res, r, 3),
			body       = cell(res, r, 4),
			created_at = cell(res, r, 5),
		}
	}
	return out
}

// --- accounts ----------------------------------------------------------------------------------

User_Result :: enum {
	Created,
	// That email already has an account.
	Exists,
	Failed,
}

user_create :: proc(email, password_hash, ip: string) -> (id: string, result: User_Result) {
	if !lock() {
		return "", .Failed
	}
	defer unlock()

	res := exec(
		`INSERT INTO users (email, password_hash, created_ip) VALUES ($1, $2, $3)
		 ON CONFLICT (email) DO NOTHING RETURNING id::text`,
		cstr(email),
		cstr(password_hash),
		cstr(ip),
	)
	defer PQclear(res)

	if !ok_status(res) {
		log.errorf("database: %s", PQresultErrorMessage(res))
		return "", .Failed
	}
	if PQntuples(res) == 0 {
		return "", .Exists
	}
	return cell(res, 0, 0), .Created
}

// The account for an email: its id and stored password hash.
user_find :: proc(email: string) -> (id, password_hash: string, found: bool) {
	if !lock() {
		return
	}
	defer unlock()

	res := exec("SELECT id::text, password_hash FROM users WHERE email = $1", cstr(email))
	defer PQclear(res)

	if !ok_status(res) || PQntuples(res) == 0 {
		return
	}
	return cell(res, 0, 0), cell(res, 0, 1), true
}

session_create :: proc(token_hash, user_id: string, lifetime_seconds: int) -> bool {
	if !lock() {
		return false
	}
	defer unlock()

	// Expired sessions are swept as new ones are made, so the table never needs a separate job.
	run("DELETE FROM sessions WHERE expires_at < now()")
	return run(
		`INSERT INTO sessions (token_hash, user_id, expires_at)
		 VALUES ($1, $2::bigint, now() + make_interval(secs => $3::int))`,
		cstr(token_hash),
		cstr(user_id),
		fmt.ctprintf("%d", lifetime_seconds),
	)
}

session_lookup :: proc(token_hash: string) -> (id, email: string, found: bool) {
	if !lock() {
		return
	}
	defer unlock()

	res := exec(
		`SELECT u.id::text, u.email FROM sessions s JOIN users u ON u.id = s.user_id
		 WHERE s.token_hash = $1 AND s.expires_at > now()`,
		cstr(token_hash),
	)
	defer PQclear(res)

	if !ok_status(res) || PQntuples(res) == 0 {
		return
	}
	return cell(res, 0, 0), cell(res, 0, 1), true
}

session_delete :: proc(token_hash: string) {
	if !lock() {
		return
	}
	defer unlock()
	run("DELETE FROM sessions WHERE token_hash = $1", cstr(token_hash))
}

auth_attempt_record :: proc(kind, ip, email: string) {
	if !lock() {
		return
	}
	defer unlock()
	// Old rows are of no use to any window we check, so trim as we go.
	run("DELETE FROM auth_attempts WHERE at < now() - interval '2 days'")
	run("INSERT INTO auth_attempts (kind, ip, email) VALUES ($1, $2, $3)", cstr(kind), cstr(ip), cstr(email))
}

// How many attempts of a kind came from an address, or for an email, within the window.
auth_attempts_count :: proc(kind, ip, email: string, window_seconds: int) -> int {
	if !lock() {
		return 0
	}
	defer unlock()

	res: PGresult
	window := fmt.ctprintf("%d", window_seconds)
	if len(email) > 0 {
		res = exec(
			`SELECT count(*)::int FROM auth_attempts
			 WHERE kind = $1 AND email = $2 AND at > now() - make_interval(secs => $3::int)`,
			cstr(kind),
			cstr(email),
			window,
		)
	} else {
		res = exec(
			`SELECT count(*)::int FROM auth_attempts
			 WHERE kind = $1 AND ip = $2 AND at > now() - make_interval(secs => $3::int)`,
			cstr(kind),
			cstr(ip),
			window,
		)
	}
	defer PQclear(res)

	if !ok_status(res) || PQntuples(res) == 0 {
		return 0
	}
	n := 0
	for ch in transmute([]u8)string(PQgetvalue(res, 0, 0)) {
		n = n * 10 + int(ch - '0')
	}
	return n
}
