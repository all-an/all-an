# Copy to .env for local development. .env is gitignored - never commit real credentials.

# --- required ---

# Local Postgres. On Railway this is a reference to the Postgres service instead.
DATABASE_URL=postgresql://allan:allan@localhost:5432/all-an-database

# --- proxy and cookies ---

# Whether to trust X-Forwarded-For. True behind Railway's proxy, false anywhere the app is
# reachable directly, where the headers could be spoofed to defeat the per-IP throttles.
TRUST_PROXY_HEADERS=false

# Whether the session cookie is HTTPS-only. Must be true in production; false locally, or the
# cookie is dropped over plain http and you can never stay signed in.
SESSION_COOKIE_SECURE=false

# --- optional ---

# The bootstrap administrator, created at startup if that username does not exist. An admin can
# remove a quiz somebody published to the shared pool. All three are needed, or none.
# ADMIN_USERNAME=allan
# ADMIN_EMAIL=allan@example.com
# ADMIN_PASSWORD=

# The site's own address.
# SITE_URL=https://your-app.up.railway.app

PORT=4200